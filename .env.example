# Copy this file to .env and fill in your real SMTP details.
PORT=3000

# SMTP server details
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sending-email@gmail.com
SMTP_PASS=your-16-character-app-password

# The address that receives website contact submissions.
CONTACT_RECEIVER=tumainisportsinitiative@gmail.com

# The mailbox shown as the sender. Usually the same as SMTP_USER.
MAIL_FROM=your-sending-email@gmail.com
